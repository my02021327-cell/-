HOST=0.0.0.0
PORT=8000
ENV=development

# Persistent SQLite/Parquet/upload storage. Relative paths resolve from project root.
DATA_DIR=./backend/storage
DATABASE_URL=sqlite:///./backend/storage/bioguard.sqlite3

# Comma-separated exact origins. Never use * as the production default.
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.0.20:3000

# Trust only the local reverse proxy in production.
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional artifact overrides; defaults are project-root-relative.
MODEL_BUNDLE_PATH=./artifacts/deployment/bioguard_a30_v2_h1_h7.joblib
RELIABILITY_SEED_PATH=./artifacts/deployment/a30_reliability_seed.parquet
